---
// A small two-dimensional lattice with one basis drawn from the origin —
// the thumbnail for the AKS paper, after the paper's Figure 1. Colours come
// from the theme tokens, so it follows light/dark with the rest of the page.
const b1 = { x: 30, y: -8 };
const b2 = { x: 8, y: -28 };
const origin = { x: 80, y: 80 };

const points: { x: number; y: number }[] = [];
for (let a = -2; a <= 2; a++) {
	for (let b = -2; b <= 2; b++) {
		if (a === 0 && b === 0) continue;
		points.push({ x: origin.x + a * b1.x + b * b2.x, y: origin.y + a * b1.y + b * b2.y });
	}
}
---

<svg class="lattice" width="160" height="160" viewBox="0 0 160 160" aria-hidden="true">
	{points.map((p) => <circle class="pt" cx={p.x} cy={p.y} r="2.5" />)}
	<path class="b1" d={`M${origin.x} ${origin.y} ${origin.x + b1.x} ${origin.y + b1.y}`} />
	<path class="b2" d={`M${origin.x} ${origin.y} ${origin.x + b2.x} ${origin.y + b2.y}`} />
	<circle class="origin" cx={origin.x} cy={origin.y} r="4" />
</svg>

<style>
	.pt {
		fill: var(--text-muted);
	}

	.b1,
	.b2 {
		fill: none;
		stroke-width: 2.5;
	}

	.b1 {
		stroke: var(--accent);
	}

	.b2 {
		stroke: var(--marker);
	}

	.origin {
		fill: var(--text);
	}
</style>
