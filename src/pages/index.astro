---
import BaseLayout from '../layouts/BaseLayout.astro';
import RowSection from '../components/RowSection.astro';
import { work } from '../data/work';

const featuredWork = work.filter((item) => item.featured);

const links = [
	{ href: 'mailto:f1@fernflores.dev', label: 'f1@fernflores.dev' },
	{ href: 'https://github.com/fernflores0463', label: 'GitHub' },
	{ href: 'https://www.linkedin.com/in/fernandohernandez1/', label: 'LinkedIn' },
	{
		href: '/resume.pdf',
		label: 'Resume',
		ariaLabel: 'Resume (PDF, opens in a new tab)',
		newTab: true,
	},
];

const education = [
	{
		years: '2015 – 2020',
		title: 'B.S. Computer Science and Cybersecurity',
		org: 'Rochester Institute of Technology',
	},
];

const experience = [
	{ years: '2024 – 2026', title: 'Software Engineer III', org: 'Compass' },
	{ years: '2024', title: 'Software Engineer II', org: 'Mastercard' },
	{ years: '2021 – 2023', title: 'Software Engineer II', org: 'JPMorgan Chase' },
	{ years: '2019 – 2021', title: 'Junior Software Engineer', org: 'Leidos' },
];
---

<BaseLayout
	title="Fernando Flores Hernandez — Software Engineer"
	description="Fernando Flores Hernandez — software engineer in Seattle, WA. Backend systems for real estate, payments, and banking."
>
	<section class="hero">
		<p class="role">Software Engineer&nbsp;&nbsp;/&nbsp;&nbsp;Seattle, WA</p>
		<h1 class="bio">I build software people rely on without having to think about it.</h1>
		<ul class="links">
			{
				links.map((link) => (
					<li>
						<a
							href={link.href}
							aria-label={link.ariaLabel}
							target={link.newTab ? '_blank' : undefined}
							rel={link.newTab ? 'noopener' : undefined}
						>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section class="prose-section prose-section--ruled" data-ink="indigo">
		<h2 class="section-label">About</h2>
		<p class="prose">
			Hi! I'm Fernando, a software engineer who's worked across real estate, payments, and
			banking. Most recently I was at Compass, building Go services and React frontends for a
			platform that thousands of real estate agents use every day. Before that I worked on
			file-transfer infrastructure at Mastercard and secured cloud services at JPMorgan Chase.
			I enjoy the unglamorous side of software: reliability, clear interfaces, and access
			control done right.
		</p>
	</section>

	<RowSection label="Education" rows={education} ink="rust" />
	<RowSection label="Experience" rows={experience} ink="amber" />

	<!-- Unmarked on purpose: the four inks belong to the four original sections. -->
	<section class="rows-section">
		<h2 class="section-label section-label--ruled">Selected work</h2>
		<ul>
			{
				featuredWork.map((item) => (
					<li class="row">
						<span class="years">{item.year}</span>
						<a href="/work" class="title">
							{item.shortTitle}
						</a>
						<span class="org">{item.kind}</span>
						<span class="note">{item.note}</span>
					</li>
				))
			}
		</ul>
		<p class="more">
			<a href="/work" class="ink-link">All work →</a>
		</p>
	</section>

	<section class="prose-section prose-section--closing" data-ink="mint">
		<h2 class="section-label">Origin</h2>
		<p class="prose">
			In high school I was good at math and science but unsure how to turn that into something I’d
			enjoy. Every summer I would try out a new class or program to explore my interests. The summer
			before my junior year I attended <a
				href="https://www.nyc.gov/site/media/shows/videos.page?id=2592"
				data-tooltip="Pause the video at 0:34 and you’ll find me in the white shirt"
				aria-description="Pause the video at 0:34 and you’ll find me in the white shirt"
				target="_blank"
				rel="noopener noreferrer"
				class="ink-link has-tooltip">NYC Generation Tech</a
			>, a summer program that taught high school students entrepreneurship and how to code. It’s a
			summer I will never forget because it’s there where my inspiration for becoming a Software
			Engineer came from.
		</p>
		<p class="prose">
			Here I am, over a decade later, living the dream the 15-year-old once had.
		</p>
	</section>
</BaseLayout>
